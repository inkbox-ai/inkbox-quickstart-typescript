# Org-scoped Inkbox API key (X-API-Key). Required.
INKBOX_API_KEY=ApiKey_...

# Webhook signing secret. Required when INKBOX_REQUIRE_SIGNATURE is true (default).
INKBOX_SIGNING_KEY=...

# When "false", skip signature verification on /webhook. Local testing only.
INKBOX_REQUIRE_SIGNATURE=true

# API root for the Inkbox control plane.
# Dev: https://development.inkbox.ai
# Beta: https://beta.inkbox.ai
# Prod: https://inkbox.ai
INKBOX_BASE_URL=https://development.inkbox.ai

# Customer-chosen subdomain. Globally unique within the env.
INKBOX_TUNNEL_NAME=

# `edge` (default) | `passthrough`. Fixed at tunnel creation; switching
# modes requires deleting the existing tunnel and creating a new one
# under a different name (60-day name lock applies).
INKBOX_TUNNEL_TLS_MODE=edge

# Per-tunnel data-plane secret. Returned ONCE at create time. Leave
# blank on first run; the SDK will create the tunnel and persist the
# secret under INKBOX_TUNNEL_STATE_DIR/state.json.
INKBOX_TUNNEL_SECRET=

# Override only if you know what you're doing. Defaults match
# INKBOX_BASE_URL: dev → development.inkboxwire.com, beta → beta.inkboxwire.com, prod → inkboxwire.com.
INKBOX_TUNNEL_ZONE=development.inkboxwire.com

# State directory. Holds state.json (and passthrough key/cert).
INKBOX_TUNNEL_STATE_DIR=./.inkbox-tunnel-state

# When "true", bypass Inkbox-managed STT/TTS and bridge call audio
# directly to the OpenAI Realtime API (g711_ulaw both ways).
USE_OPENAI_REALTIME=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
